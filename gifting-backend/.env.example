# ---- Server ----
PORT=4000
NODE_ENV=development

# CORS origin - comma-separated for multiple origins
# Local dev only:
FRONTEND_ORIGIN=http://localhost:5173
# Production (add your Vercel URL):
# FRONTEND_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# ---- Database (PostgreSQL) ----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gifting?schema=public"

# ---- JWT for admin auth ----
# Generate with: openssl rand -hex 64
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Razorpay ----
# Get these from https://dashboard.razorpay.com -> Account & Settings -> API Keys
# In test mode, key starts with rzp_test_; in live mode, rzp_live_
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Cloudinary (image uploads) ----
# Get these from https://console.cloudinary.com/settings
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=kasturi-products