# ---- Server ----
PORT=4000
NODE_ENV=development

# CORS origin - your frontend URL (the UI built in your other tool)
FRONTEND_ORIGIN=http://localhost:5173

# ---- Database (PostgreSQL) ----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gifting?schema=public"

# ---- JWT for admin auth ----
# Generate with: openssl rand -hex 64
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Razorpay ----
# Get these from https://dashboard.razorpay.com -> Account & Settings -> API Keys
# In test mode, key starts with rzp_test_; in live mode, rzp_live_
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- File uploads ----
cloudinaryCloudName: required("CLOUDINARY_CLOUD_NAME"),
cloudinaryApiKey: required("CLOUDINARY_API_KEY"),
cloudinaryApiSecret: required("CLOUDINARY_API_SECRET"),
cloudinaryFolder: optional("CLOUDINARY_FOLDER", "gifting-products"),